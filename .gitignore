# The client compiles src/ in place while it runs.
*.pyc
*.pyo
__pycache__/

# Rendered from dev/mod_battle_conquest_dev.py.in with a machine-specific path.
dev/mod_battle_conquest_dev.py

# Points the mod at a local site; see config.py.
src/battle_conquest/local_settings.py

# Build output.
/dist/
/build/

.venv/
.DS_Store

# Local workspace configuration; never part of the mod package.
/.env.local
